---
import type { Settings } from "../lib/content";
interface Props { settings: Settings }
const { settings: s } = Astro.props;
---
<header class="top">
  <a class="brand" href="/">Kaden Johnson <span>UX/UI Designer</span></a>
  <nav aria-label="Main">
    <a class="opt" href="#work">Work</a>
    <a class="opt" href="#say-hi">Say hi</a>
    <a href={s.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <button class="pill" type="button" data-copy={s.email}>Copy email</button>
  </nav>
</header>
