---
// Image box: the real image when there is one, otherwise a labeled placeholder
import { img } from "../data/projects";
import { imageUrl } from "../lib/content";
import type { SanityImage } from "../data/local";
interface Props { src?: string | null; image?: SanityImage; label: string; ratio?: string; alt?: string }
const { src, image, label, ratio = "4/3", alt } = Astro.props;
const url = imageUrl(image, src, (f) => `/images/${img(f)}`);
---
{url ? (
  <div class="ph is-real" style={`aspect-ratio:${ratio}`}>
    <img src={url} alt={alt || label} loading="lazy" decoding="async" />
  </div>
) : (
  <div class="ph empty" style={`aspect-ratio:${ratio}`}>
    <span class="ph-tag"><b>{label}</b><span>Image goes here</span></span>
  </div>
)}
