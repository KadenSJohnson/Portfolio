---
// A looping, muted clip (plays inline on phones); the poster holds its space until it loads
import type { VideoInfo } from "../data/projects";
interface Props { video: VideoInfo }
const { video } = Astro.props;
---
<div class="vid-wrap">
  <video src={video.src} poster={`/images/${video.poster}`} autoplay muted loop playsinline preload="metadata" aria-label={video.label}></video>
</div>
