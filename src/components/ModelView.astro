---
// WebGL canvas for a low poly model; src/scripts/app.js mounts it (OBJ text is inlined on the page)
import type { ModelInfo } from "../data/projects";
interface Props { model: ModelInfo; big?: boolean }
const { model, big = false } = Astro.props;
---
{big ? (
  <div class="model-wrap big" data-model-wrap>
    <canvas data-model={model.key} data-yaw={model.yaw} data-pitch={model.pitch} data-color={model.color} data-interactive tabindex="0" role="img"
      aria-label={`Low poly 3D model of ${model.what}. Drag or use the arrow keys to rotate.`}></canvas>
    <p class="model-hint" aria-hidden="true">Drag to spin</p>
    <p class="no-gl-msg">3D preview needs WebGL</p>
  </div>
) : (
  <div class="model-wrap" data-model-wrap>
    <canvas data-model={model.key} data-yaw={model.yaw} data-pitch={model.pitch} data-color={model.color} aria-hidden="true"></canvas>
    <p class="no-gl-msg">3D preview needs WebGL</p>
  </div>
)}
