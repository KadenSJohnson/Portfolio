---
// Cutting-mat furniture: rulers, corner box, printed marks and the angle guide
---
<div class="ruler top" aria-hidden="true"><div class="nums" id="ruler-x"></div></div>
<div class="ruler left" aria-hidden="true"><div class="nums" id="ruler-y"></div></div>
<div class="corner-box" aria-hidden="true"></div>
<div class="marks" aria-hidden="true">
  <span class="mk mk-tr">KADEN JOHNSON<br />UX/UI DESIGNER</span>
  <span class="mk mk-side">GRID 1 IN · ½ IN · SPRINGVILLE, UTAH</span>
  <svg class="angles" viewBox="0 0 420 420" preserveAspectRatio="xMinYMax meet">
    <g fill="none" stroke="currentColor" stroke-width="1.2">
      <line x1="0" y1="420" x2="420" y2="177.5" />
      <line x1="0" y1="420" x2="420" y2="0" />
      <line x1="0" y1="420" x2="242.5" y2="0" />
      <path d="M120 420 A120 120 0 0 0 0 300" stroke-dasharray="3 5" />
      <path d="M240 420 A240 240 0 0 0 0 180" stroke-dasharray="3 5" />
    </g>
    <g fill="currentColor" font-size="13" font-family="IBM Plex Mono, monospace" font-weight="500">
      <text x="300" y="232">30°</text><text x="250" y="148">45°</text><text x="150" y="96">60°</text>
    </g>
  </svg>
</div>
