<dialog class="lb" id="lightbox" aria-labelledby="lb-title">
  <div class="sheet">
    <div class="lb-bar">
      <div class="lb-nav">
        <button class="lb-btn" type="button" data-step="-1" aria-label="Previous project"><svg class="flip" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arw" /></svg></button>
        <button class="lb-btn" type="button" data-step="1" aria-label="Next project"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arw" /></svg></button>
      </div>
      <button class="lb-btn" type="button" data-close aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-close" /></svg></button>
    </div>
    <header class="lb-head">
      <div class="tags" id="lb-tags"></div>
      <h2 id="lb-title"></h2>
      <p class="lb-sub" id="lb-sub"></p>
    </header>
    <div id="lb-content"></div>
  </div>
  <div class="zoom" id="zoom" hidden role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="lb-btn zoom-close" type="button" data-zoom-close aria-label="Close image"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-close" /></svg></button>
    <img id="zoom-img" alt="" />
    <p class="zoom-hint" aria-hidden="true">Tap the image to zoom in</p>
  </div>
</dialog>
