---
import { img, type Quote } from "../data/projects";
interface Props { item: Quote }
const { item: q } = Astro.props;
---
<figure class="obj index quote" data-cat="widget" style={`--r:${q.r}deg`}>
  <img class="q-logo" src={`/images/${img(q.logo)}`} alt="" loading="lazy" />
  <blockquote><p>“{q.quote}”</p></blockquote>
  <figcaption><img class="init" src={`/images/${img(q.photo)}`} alt="" loading="lazy" /><span><b>{q.who}</b><span>{q.role}</span></span></figcaption>
</figure>
