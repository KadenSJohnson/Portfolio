---
import { img } from "../data/projects";
import { imageUrl, type Testimonial } from "../lib/content";
interface Props { item: Testimonial }
const { item: q } = Astro.props;
const path = (f: string) => `/images/${img(f)}`;
const logo = imageUrl(q.logo, q.logoFile, path, 400);
const photo = imageUrl(q.photo, q.photoFile, path, 160);
---
<figure class="obj quote" data-cat="widget">
  {logo && <img class="q-logo" src={logo} alt="" loading="lazy" />}
  <blockquote><p>“{q.quote}”</p></blockquote>
  <figcaption>{photo && <img class="init" src={photo} alt="" loading="lazy" />}<span><b>{q.name}</b><span>{q.role}</span></span></figcaption>
</figure>
