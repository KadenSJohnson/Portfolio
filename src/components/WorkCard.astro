---
// A project on the mat, plus the <template> the lightbox clones when it opens
import type { Project } from "../lib/content";
import { FEATURES } from "../data/projects";
import Ph from "./Ph.astro";
import Tag from "./Tag.astro";
import BeforeAfter from "./BeforeAfter.astro";
import ModelView from "./ModelView.astro";
import RichText from "./RichText.astro";
interface Props { item: Project }
const { item: it } = Astro.props;
const f = FEATURES[it.id] || {};
const metal = it.material === "metal";
---
<article class={`obj ${it.material}${it.wide ? " wide" : ""}`} data-cat={it.categories.join(" ")} data-id={it.id} style={`--r:${it.tilt}deg`}>
  {metal && <><i class="screw s1"></i><i class="screw s2"></i><i class="screw s3"></i><i class="screw s4"></i></>}
  <div class="obj-img">
    {f.ba ? <BeforeAfter ba={f.ba} /> : f.model ? <ModelView model={f.model} /> : <Ph src={it.imageFile} image={it.image} label={it.imageLabel} ratio={it.imageRatio || "4/3"} />}
  </div>
  <div class="obj-cap">
    <h2 class="obj-title" id={`t-${it.id}`}>{it.title}</h2>
    <p class="obj-sub">{it.subtitle}</p>
    <div class="tags">{it.categories.map((c) => <Tag cat={c} />)}</div>
  </div>
  <button class="hit" type="button" data-open={it.id} aria-haspopup="dialog" aria-labelledby={`t-${it.id}`}></button>
</article>
<template id={`p-${it.id}`} data-title={it.title} data-sub={it.subtitle} data-cats={it.categories.join(" ")}>
  <div class="lb-hero">
    {f.ba ? <BeforeAfter ba={f.ba} big /> : f.model ? <ModelView model={f.model} big /> : <Ph src={it.imageFile} image={it.image} label={it.imageLabel} ratio="16/9" />}
  </div>
  <div class="lb-body"><RichText blocks={it.body} /></div>
</template>
