---
// A project on the mat, plus the <template> the lightbox clones when it opens
import type { Project } from "../lib/content";
import { FEATURES } from "../data/projects";
import Ph from "./Ph.astro";
import { CARD_SIZES } from "../lib/srcset";
import Tag from "./Tag.astro";
import BeforeAfter from "./BeforeAfter.astro";
import ModelView from "./ModelView.astro";
import VideoView from "./VideoView.astro";
import RichText from "./RichText.astro";
// eager: the first row loads right away (it's on the first screen) instead of lazily
interface Props { item: Project; eager?: boolean }
const { item: it, eager = false } = Astro.props;
// Built-in extras (KPM compare, Flint video) attach by the document, so renaming a project's slug keeps them.
// Anything uploaded in Sanity (a card video or card image) takes their place.
const base = FEATURES[it.id] || FEATURES[(it.docId || "").replace(/^(drafts\.)?project-/, "")] || {};
const f = it.coverVideo
  ? { video: { src: it.coverVideo, poster: "", label: it.imageLabel || it.title } }
  : it.image?.asset ? {} : base;
---
<article class={`obj${it.wide ? " wide" : ""}`} data-cat={it.categories.join(" ")} data-id={it.id}>
  <div class="obj-img">
    {f.ba ? <BeforeAfter ba={f.ba} eager={eager} /> : f.video ? <VideoView video={f.video} /> : f.model ? <ModelView model={f.model} /> : <Ph src={it.imageFile} image={it.image} label={it.imageLabel} ratio={it.imageRatio || "4/3"} sizes={CARD_SIZES} eager={eager} />}
  </div>
  <div class="obj-cap">
    <h2 class="obj-title" id={`t-${it.id}`}>{it.title}</h2>
    <p class="obj-sub">{it.subtitle}</p>
    <div class="tags">{it.categories.map((c) => <Tag cat={c} />)}</div>
  </div>
  <button class="hit" type="button" data-open={it.id} aria-haspopup="dialog" aria-labelledby={`t-${it.id}`}></button>
</article>
<template id={`p-${it.id}`} data-title={it.title} data-sub={it.subtitle} data-cats={it.categories.join(" ")}>
  <div class="lb-hero">
    {f.ba ? <BeforeAfter ba={f.ba} big /> : f.video ? <VideoView video={f.video} /> : f.model ? <ModelView model={f.model} big /> : <Ph src={it.imageFile} image={it.image} label={it.imageLabel} ratio="16/9" />}
  </div>
  <div class="lb-body"><RichText blocks={it.body} /></div>
</template>
