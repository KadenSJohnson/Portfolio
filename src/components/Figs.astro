---
import Ph from "./Ph.astro";
import type { SanityImage } from "../data/local";
interface Props { items: { imageFile?: string; image?: SanityImage; label: string }[]; cols?: number }
const { items, cols = 2 } = Astro.props;
---
<div class={`figs c${cols}`}>
  {items.map((f) => <figure><Ph src={f.imageFile} image={f.image} label={f.label} ratio="16/10" /><figcaption>{f.label}</figcaption></figure>)}
</div>
