---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Hero from "../components/Hero.astro";
import Filters from "../components/Filters.astro";
import WorkCard from "../components/WorkCard.astro";
import QuoteCard from "../components/QuoteCard.astro";
import ContactCard from "../components/ContactCard.astro";
import Lightbox from "../components/Lightbox.astro";
import { getContent } from "../lib/content";
import kiwiObj from "../models/kiwi.obj?raw";
import rockObj from "../models/rock.obj?raw";

const { settings, projects, testimonials } = await getContent();
// Projects and testimonials share one gallery, ordered by their "order" number
const gallery = [
  ...projects.map((p) => ({ kind: "work" as const, order: p.order ?? 0, p })),
  ...testimonials.map((t) => ({ kind: "quote" as const, order: t.order ?? 0, t })),
].sort((a, b) => a.order - b.order);
const objs = { kiwi: kiwiObj, rock: rockObj };
---
<Layout title="Kaden Johnson · Portfolio" description="Kaden Johnson is a UX/UI designer in Salt Lake City, Utah, working across websites, product, and internal tools.">
  <div class="canvas">
  <div class="page">
    <TopBar settings={settings} />
    <Hero settings={settings} />
    <section id="work" aria-labelledby="work-label">
      <div class="work-head" data-snap>
        <h2 class="label" id="work-label">Selected work</h2>
        <Filters projects={projects} />
      </div>
      <div class="gallery">
        {gallery.map((g) => (g.kind === "work" ? <WorkCard item={g.p} /> : <QuoteCard item={g.t} />))}
      </div>
    </section>
    <ContactCard settings={settings} />
    <footer class="foot">
      <span>Designed and coded by Kaden Johnson</span>
      <span>© 2026</span>
    </footer>
  </div>
  </div>
  <Lightbox />
  {Object.entries(objs).map(([k, src]) => <script type="text/plain" id={`obj-${k}`} is:inline set:html={src}></script>)}
  <script>
    import "../scripts/app.js";
    import "../scripts/hero.js";
    import "../scripts/grid.js";
  </script>
</Layout>
