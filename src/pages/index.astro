---
import Layout from "../layouts/Layout.astro";
import MatMarks from "../components/MatMarks.astro";
import Intro from "../components/Intro.astro";
import Filters from "../components/Filters.astro";
import WorkCard from "../components/WorkCard.astro";
import QuoteCard from "../components/QuoteCard.astro";
import ContactCard from "../components/ContactCard.astro";
import Lightbox from "../components/Lightbox.astro";
import { getContent } from "../lib/content";
import kiwiObj from "../models/kiwi.obj?raw";
import rockObj from "../models/rock.obj?raw";

const { settings, projects, testimonials } = await getContent();
// Projects and testimonials share one gallery, ordered by their "order" number
const gallery = [
  ...projects.map((p) => ({ kind: "work" as const, order: p.order ?? 0, p })),
  ...testimonials.map((t) => ({ kind: "quote" as const, order: t.order ?? 0, t })),
].sort((a, b) => a.order - b.order);
const objs = { kiwi: kiwiObj, rock: rockObj };
---
<Layout title="Kaden Johnson · Portfolio" description="Kaden Johnson is a UX/UI designer in Springville, Utah, working across websites, product, and internal tools.">
  <div class="mat" id="mat">
    <MatMarks />
    <div class="page">
      <Intro settings={settings} />
      <Filters projects={projects} />
      <main class="gallery" id="work">
        {gallery.map((g) => (g.kind === "work" ? <WorkCard item={g.p} /> : <QuoteCard item={g.t} />))}
        <ContactCard settings={settings} />
      </main>
      <footer class="foot">
        <span>© 2026 Kaden Johnson</span>
        <span>{settings.email}</span>
      </footer>
    </div>
  </div>
  <Lightbox />
  {Object.entries(objs).map(([k, src]) => <script type="text/plain" id={`obj-${k}`} is:inline set:html={src}></script>)}
  <script>
    import "../scripts/app.js";
  </script>
</Layout>
