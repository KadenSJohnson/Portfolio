---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import Device from "../../components/Device.astro";
import { getContent } from "../../lib/content";

export async function getStaticPaths() {
  const { redlines } = await getContent();
  return redlines.map((r) => ({ params: { id: r.id }, props: { id: r.id } }));
}
const { id } = Astro.props;
const { settings, redlines } = await getContent();
const r = redlines.find((x) => x.id === id)!;
const fmt = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
const day = (d: string) => (d ? fmt.format(new Date(d + "T00:00:00Z")) : "");
---
<Layout title={`${r.title} · Redlines · Kaden Johnson`} description={`${r.app}: ${r.title}`}>
  <div class="canvas">
  <div class="page">
    <TopBar settings={settings} base="/" />
    <a class="rl-back gcard" href="/redlines/" data-snap><span aria-hidden="true">←</span> All redlines</a>
    <article class="rl-detail gcard" data-snap>
      <div class={`rl-media is-${r.device}`}><Device r={r} /></div>
      <div class="rl-text">
        <p class="rl-meta"><span>{r.app}</span><time datetime={r.date}>{day(r.date)}</time></p>
        <h1 class="rl-title big">{r.title}</h1>
        <dl class="rl-parts">
          <div><dt>What I noticed</dt><dd>{r.problem}</dd></div>
          <div><dt>Why it matters</dt><dd>{r.why}</dd></div>
          <div><dt>How I'd fix it</dt><dd>{r.fix}</dd></div>
        </dl>
      </div>
    </article>
    <footer class="foot gcard" data-snap>
      <a href="/">Back to the portfolio</a>
      <span>© 2026</span>
    </footer>
  </div>
  </div>
  <script>
    import "../../scripts/grid.js";
    // Copy email in the top bar
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => b.addEventListener("click", () => {
      const done = () => { b.textContent = "Copied"; setTimeout(() => { b.textContent = "Copy email"; }, 1600); };
      try { navigator.clipboard.writeText(b.dataset.copy || "").then(done, () => {}); } catch (e) {}
    }));
  </script>
</Layout>
