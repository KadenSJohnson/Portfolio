---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import Device from "../../components/Device.astro";
import Lightbox from "../../components/Lightbox.astro";
import RichText from "../../components/RichText.astro";
import { getContent } from "../../lib/content";

const { settings, redlines } = await getContent();
const fmt = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
const day = (d: string) => (d ? fmt.format(new Date(d + "T00:00:00Z")) : "");
---
<Layout title="My Nitpicks · Kaden Johnson" description="Small problems Kaden Johnson notices in the apps he uses, and how he'd fix them.">
  <div class="canvas">
  <main class="page">
    <TopBar settings={settings} base="/" />
    <header class="rl-head gcard" data-snap data-np>
      <h1 class="np-title"><span class="np-word" data-np-word>My nitpicks<i class="hd tl" aria-hidden="true"></i><i class="hd tr" aria-hidden="true"></i><i class="hd bl" aria-hidden="true"></i><i class="hd br" aria-hidden="true"></i></span></h1>
      <p class="np-lede">Small things I notice in the apps I use, and how I'd fix them.</p>
      <span class="np-guide" aria-hidden="true"></span>
      <span class="np-pin" aria-hidden="true"><b></b><span class="np-bubble">Can we fix this?</span></span>
      <span class="np-cur you" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 3l14 8.5-6.2 1.3L9.6 19z" fill="#9747FF" stroke="#FFFFFF" stroke-width="1.5" stroke-linejoin="round" /></svg><em>You</em></span>
      <span class="np-cur me" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 3l14 8.5-6.2 1.3L9.6 19z" fill="#0D99FF" stroke="#FFFFFF" stroke-width="1.5" stroke-linejoin="round" /></svg><em>Kaden</em></span>
      <p class="rl-count">{redlines.length} {redlines.length === 1 ? "nitpick" : "nitpicks"}</p>
    </header>
    <div class="rl-list">
      {redlines.map((r) => (
        <article class="rl gcard" data-id={r.id} data-snap>
          <div class={`rl-media is-${r.device}`}><Device r={r} /></div>
          <div class="rl-cap">
            <p class="rl-meta"><span>{r.app}</span><time datetime={r.date}>{day(r.date)}</time></p>
            <h2 class="rl-title" id={`t-${r.id}`}>{r.title}</h2>
          </div>
          <button class="hit" type="button" data-open={r.id} aria-haspopup="dialog" aria-labelledby={`t-${r.id}`}></button>
        </article>
      ))}
    </div>
    {redlines.map((r) => (
      <template id={`p-${r.id}`} data-title={r.title} data-sub={`${r.app} · ${day(r.date)}`}>
        <div class="lb-hero"><div class={`rl-media is-${r.device}`}><Device r={r} /></div></div>
        <div class="lb-body">
          {[[r.heading1, r.body1], [r.heading2, r.body2], [r.heading3, r.body3]].filter(([h, b]) => h || (b && b.length)).map(([h, b]) => (
            <section class="lb-sec">{h && <h3>{h}</h3>}<RichText blocks={(b as any) || []} /></section>
          ))}
        </div>
      </template>
    ))}
    <footer class="foot gcard" data-snap>
      <a href="/">Back to the portfolio</a>
      <span>© 2026</span>
    </footer>
  </main>
  </div>
  <Lightbox />
  <script>
    import "../../scripts/reveal.js";
    import "../../scripts/app.js";
    import "../../scripts/grid.js";
    import "../../scripts/nitpicks.js";
  </script>
</Layout>
